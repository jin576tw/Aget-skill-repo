{
  "description": "Aget checkpoint flush and per-turn journal; the journal writes only when MEMORY_VAULT is set and no setup installation with hooks owns the cwd.",
  "hooks": {
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs\" --plugin", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs\" --plugin", "timeout": 5 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs\" --plugin", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs\" --plugin", "timeout": 5 }] }],
    "TaskCompleted": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs\" --plugin", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record.mjs\" --plugin", "timeout": 5 }] }]
  }
}
